# Copy to .env.local for local development. Never commit the real values -
# see README.md for the credential-rotation note before this goes live.

# Used by the Next.js app's server-side API routes (read-only queries against
# Supabase reporting views).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Used by scripts/sync.ts (and, in CI, by .github/workflows/sync.yml via the
# DATABASE_URL repository secret) for the transactional truncate+reload.
DATABASE_URL=
